{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inti.tech/samdebug/schemas/tool-manifest-v1.schema.json",
  "title": "samdebug managed tool manifest v1",
  "type": "object",
  "required": ["schema_version", "channel", "installable", "required_tools", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "channel": {"const": "pinned"},
    "installable": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "required_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "pins": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|(^|/)\\.(/|$))"}
    },
    "artifact": {
      "type": "object",
      "required": [
        "name", "version", "os", "architecture", "url", "allowed_hosts",
        "sha256", "archive", "executables", "licenses", "source_url",
        "source_sha256", "source_offer"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "allowed_hosts": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "archive": {
          "type": "object",
          "required": ["kind", "root"],
          "properties": {
            "kind": {"const": "tar.xz"},
            "root": {"$ref": "#/$defs/relativePath"}
          },
          "additionalProperties": false
        },
        "executables": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "path", "version_args", "version_contains"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "path": {"$ref": "#/$defs/relativePath"},
              "version_args": {"type": "array", "items": {"type": "string"}},
              "version_contains": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "licenses": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["spdx", "path"],
            "properties": {
              "spdx": {"type": "string", "minLength": 1},
              "path": {"$ref": "#/$defs/relativePath"}
            },
            "additionalProperties": false
          }
        },
        "source_url": {"type": "string", "pattern": "^https://"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_offer": {"const": "accompanying-source"}
      },
      "additionalProperties": false
    }
  }
}
